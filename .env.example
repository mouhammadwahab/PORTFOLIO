# EmailJS (contact form) — set these in Vercel Project Settings → Environment Variables
# and locally in a `.env` file (never commit `.env`).
#
# EmailJS "Public Key" is intended for browser use, but keep IDs out of source control.

REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_contact_template_id
REACT_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
